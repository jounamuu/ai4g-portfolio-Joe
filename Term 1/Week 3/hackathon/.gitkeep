import os
import streamlit as st
from dotenv import load_dotenv
import json
import re

try:
    import google.generativeai as genai
except ImportError:
    st.error("You need to install the google-generativeai library. Run: pip install google-generativeai")
    st.stop()

# --- Load environment variables from .env file ---
load_dotenv()
API_KEY = os.getenv("GEMINI_API_KEY")

if not API_KEY:
    st.error("Error: The 'GEMINI_API_KEY' variable could not be found in your .env file. Please set it up before using this app.")
    st.stop()

# --- Configure the Gemini API ---
genai.configure(api_key=API_KEY)

# --- Supported languages and robust system instructions/schema ---
LANGUAGE_OPTIONS = {
    "English":    "en",
    "Spanish":    "es",
    "French":     "fr",
    "Arabic":     "ar",
    "Ukrainian":  "uk",
    "Chinese":    "zh"
}

def build_system_prompt(lang_code):
    if lang_code == "en":
        return (
            "You are ClearBureaucracy AI. Your task: Parse, analyze, and summarize official, legal, or government letters. "
            "Follow every instruction below strictly: "
            "\nReply ONLY in strict, valid JSON. The JSON MUST have exactly these five keys:"
            "\n- \"summary\": A detailed and easy-to-understand explanation in English, clearly identifying who sent the letter, what they request, and why, without omitting context."
            "\n- \"action_steps\": A list of 2 to 5 concrete, essential, distinct, actionable tasks. Each step must specify offices, documents, or requirements precisely—never generic headers or empty items. No placeholders, no dashes, no category titles, and no empty items."
            "\n- \"deadline\": The exact deadline and its calculation (e.g., \"within 10 working days beginning the day after you receive this letter\") or exactly \"Not specified\" if the document mentions none. DO NOT invent or abbreviate dates."
            "\n- \"consequences\": A clear summary of legal or administrative consequences if no action is taken, using specific examples from the text (e.g., 'application will be refused, risk of losing residency'), or leave blank if not present."
            "\n- \"warning\": A professional advisory reminding the user to verify all key requirements with a legal aid worker or case officer."
            "\nIf you cannot fill a value, use an empty string (\"\"), except for deadline, which must be \"Not specified\" if absent."
            "\nDO NOT write markdown, explanations, or commentary—output ONLY the JSON, never anything else."
        )
    elif lang_code == "es":
        return (
            "Eres ClearBureaucracy AI. Analiza y resume cartas oficiales, legales o gubernamentales."
            "\nResponde SOLO con un objeto JSON válido y preciso, con exactamente estas cinco claves:"
            "\n- \"summary\": Explicación detallada y sencilla en español, identificando quién envía la carta, qué solicita y por qué."
            "\n- \"action_steps\": Lista de 2 a 5 pasos esenciales, concretos y específicos, sin encabezados ni puntos vacíos."
            "\n- \"deadline\": Plazo exacto tal como lo indica la carta (ejemplo: 'dentro de 10 días hábiles a partir del día siguiente a la recepción'), o exactamente 'No especificada' si no hay."
            "\n- \"consequences\": Consecuencias legales/administrativas específicas si no se cumple; dejar \"\" si no se indica."
            "\n- \"warning\": Un aviso profesional de consultar con un asesor."
            "\nSin explicaciones, comentarios ni formato—solo el JSON y nada más."
        )
    elif lang_code == "fr":
        return (
            "Vous êtes ClearBureaucracy AI, spécialiste de la simplification des lettres officielles ou juridiques."
            "\nRépondez EXCLUSIVEMENT avec un objet JSON (rien d'autre), structuré ainsi :"
            "\n- \"summary\" : Explication détaillée et claire en français, précisant qui envoie, ce qui est demandé et pourquoi."
            "\n- \"action_steps\" : Liste de 2 à 5 étapes essentielles, précises, sans titres génériques ni éléments vides."
            "\n- \"deadline\" : Date et modalités précises (ex: 'sous 10 jours ouvrés...') ou exactement 'Non spécifiée' si absente."
            "\n- \"consequences\" : Détail des conséquences juridiques/administratives sinon mettre \"\"."
            "\n- \"warning\" : Mise en garde de consulter un spécialiste."
            "\nAucune explication extérieure ou format — strictement le JSON !"
        )
    elif lang_code == "ar":
        return (
            "أنت ClearBureaucracy AI. لخص رسائل رسمية أو قانونية بدقة."
            "\nأجب فقط بجسم JSON كالتالي دون أي شرح خارجي:"
            "\n- \"summary\": شرح مفصل وسهل بالعربية يوضح من المرسل وما المطلوب ولماذا."
            "\n- \"action_steps\": قائمة من 2 إلى 5 خطوات أساسية محددة، دون عناوين أو عناصر فارغة."
            "\n- \"deadline\": الموعد النهائي كما هو بالنص (مثال: 'خلال 10 أيام عمل...') أو بالضبط 'غير محدد' إذا غاب."
            "\n- \"consequences\": العقوبات أو النتائج القانونية إنْ وُجدت، وإلا \"\"."
            "\n- \"warning\": تنبيه بمراجعة مختص."
            "\nلا تكتب غير نص JSON."
        )
    elif lang_code == "uk":
        return (
            "Ви — ClearBureaucracy AI. Аналізуйте офіційні документи та відповідайте лише у вигляді коректного JSON:"
            "\n- \"summary\": Детальне, зрозуміле пояснення українською, хто відправник, що і чому просить."
            "\n- \"action_steps\": 2-5 чітких кроків, без заголовків чи порожніх пунктів."
            "\n- \"deadline\": Точний термін або саме 'Не зазначено' якщо його немає."
            "\n- \"consequences\": Конкретні наслідки, або \"\"."
            "\n- \"warning\": Радьте звертатися до юриста."
            "\nБез пояснень поза JSON!"
        )
    elif lang_code == "zh":
        return (
            "你是ClearBureaucracy AI，只返回严格格式的JSON对象："
            "\n- \"summary\": 用中文详细、易懂地说明，清楚指出发送人、要求和原因。"
            "\n- \"action_steps\": 2-5项具体步骤，无条目标题、无空项。"
            "\n- \"deadline\": 信件原文里的时间节点，若无则只写“未说明”。"
            "\n- \"consequences\": 未履行时的行政/法律后果，无则设为“”。"
            "\n- \"warning\": 提醒用户咨询专业人士。"
            "\n除了JSON别输出任何内容。"
        )
    else:
        return (
            "You are ClearBureaucracy AI. Return ONLY valid JSON as described below: "
            '{"summary": "...", "action_steps": ["..."], "deadline": "...", "consequences": "...", "warning": "..."}'
            "\nDo not output markdown or anything except strict JSON with those five keys as described."
        )

COMMON_ACTION_HEADER_PATTERNS = [
    re.compile(r"^\s*(Pasos a seguir|Checklist|Step(?:s)?|Items|Instructions|Actions?|Fechas|Dates?)\s*:?\s*$", re.IGNORECASE),
]

def filter_action_steps(steps):
    clean_steps = []
    for idx, step in enumerate(steps):
        # Remove leading numbering/bullets/spaces
        cleaned = re.sub(r"^\s*[\d\.\-•–\*\u2022\u2013]+\s*", '', step).strip()
        # Discard if too short
        if len(cleaned) < 8:
            continue
        # Discard headers
        if any(pat.match(cleaned) for pat in COMMON_ACTION_HEADER_PATTERNS):
            continue
        # Discard if step is only dashes or punctuation
        if re.fullmatch(r"[\s\-\–\_\.\,]+", cleaned):
            continue
        clean_steps.append(cleaned)
    return clean_steps

# --- Streamlit UI Layout ---
st.set_page_config(page_title="📋 ClearBureaucracy", page_icon="📋", layout="centered")
st.title("📋 ClearBureaucracy")
st.subheader("Making government and legal documents simple for everyone")
st.markdown(
    "ClearBureaucracy turns complex official, legal, and government letters into plain, understandable language for everyone. "
    "Paste a document below, select your language, and let our AI deliver a clear, actionable summary. "
    "Specially designed to support immigrants and vulnerable communities."
)

selected_language = st.selectbox(
    "Choose your language:",
    options=list(LANGUAGE_OPTIONS.keys()),
    index=0,
    help="The AI will reply in the selected language."
)

st.markdown("**Paste official/government/legal letter OR upload PDF/image below:**")

uploaded_file = st.file_uploader("Upload a document (PDF, image, etc.)", type=["pdf", "png", "jpg", "jpeg", "heic"], accept_multiple_files=False)
text_input_hint = "Paste the document text here..."

document_text = st.text_area(
    label="Document text area",
    height=220,
    placeholder=text_input_hint
)

if uploaded_file:
    try:
        filetype = uploaded_file.type
        with st.spinner("Extracting text from uploaded document..."):
            if filetype == "application/pdf":
                import io
                from pypdf import PdfReader
                pdf_reader = PdfReader(uploaded_file)
                file_text = []
                for page in pdf_reader.pages:
                    file_text.append(page.extract_text() or "")
                extracted = "\n".join(file_text).strip()
            elif filetype.startswith("image/"):
                from PIL import Image
                import pytesseract
                image = Image.open(uploaded_file)
                extracted = pytesseract.image_to_string(image)
            else:
                extracted = ""
            if extracted and len(extracted.strip()) > 20:
                document_text = extracted
                st.success("Extracted text from uploaded file — you may add or correct it below.")
            else:
                st.warning("Sorry, no usable text could be extracted from this file. Paste the text manually below.")
    except Exception as fileexc:
        st.warning(f"Could not process file: {fileexc}. Please paste the text manually below.")

if st.button("Analyze & Simplify Document"):
    if not document_text or len(document_text.strip()) < 30:
        st.warning("Please paste a longer official document (at least 30 characters) to get a useful analysis.")
    else:
        lang_code = LANGUAGE_OPTIONS.get(selected_language, "en")
        system_prompt = build_system_prompt(lang_code)
        # Compose FINAL prompt as a single string for Gemini API
        input_prompt = (
            f"{system_prompt}\n\n---\n\nDocument:\n{document_text}\n\n"
            "Reply strictly in the JSON schema specified above. Do not add any comments or text outside the JSON object."
        )
        with st.spinner("Analyzing and parsing your document... Please wait."):
            try:
                model = genai.GenerativeModel(model_name="gemini-3.6-flash", system_instruction=None)
                response = model.generate_content(
                    input_prompt,
                    generation_config={"temperature": 0.1, "max_output_tokens": 2048}
                )
                text = getattr(response, "text", None) or ""
                # Robust JSON extraction: Try to find/parse the single JSON block
                json_data = None
                if text.strip().startswith("{") and text.strip().endswith("}"):
                    try:
                        json_data = json.loads(text)
                    except Exception:
                        pass
                if not json_data:
                    # Try to extract a JSON block even if model added accidental extra commentary
                    match = re.search(r'(\{[\s\S]+?\})', text)
                    if match:
                        try:
                            json_data = json.loads(match.group(1))
                        except Exception:
                            json_data = None
                if not json_data:
                    st.warning(
                        "Could not parse a structured summary from the AI. Please retry or check that your document is a standard, official text."
                    )
                else:
                    summary = json_data.get("summary", "").strip()
                    steps = json_data.get("action_steps", [])
                    deadline = json_data.get("deadline", "").strip()
                    consequences = json_data.get("consequences", "").strip()
                    warning_advice = json_data.get("warning", "").strip()

                    # Step list robustness
                    if isinstance(steps, str):
                        steps = [steps]
                    steps = filter_action_steps(steps)
                    steps = steps[:5]

                    # --- --- Visual Layout --- ---

                    # Informative summary card
                    if summary:
                        st.info(f"**Summary:**\n\n{summary}")

                    st.markdown("---")
                    # Action steps cards
                    if steps:
                        st.markdown("**Essential steps to take:**")
                        for idx, step in enumerate(steps, 1):
                            st.write(f"**{idx}.** {step}")

                    # Side-by-side for deadline & consequences
                    c1, c2 = st.columns(2)
                    with c1:
                        st.metric(label="Deadline", value=deadline or "Not specified")
                    with c2:
                        st.markdown(f"**If ignored:**<br/>{consequences or '—'}", unsafe_allow_html=True)

                    if warning_advice:
                        st.warning(warning_advice)
            except Exception as exc:
                st.error(
                    f"An error occurred while processing your request. "
                    f"Details:\n\n{exc}\n\n"
                    "Please check your API key, your internet connection, and try again later."
                )

# --- Disclaimer ---
st.markdown("""
---
**Disclaimer:**  
This service uses artificial intelligence to simplify documents. For important matters, always consult a qualified legal aid worker or trusted advisor. Do not rely solely on these results for legal or official decisions.
""")
